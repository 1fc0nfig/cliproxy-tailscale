# Extends the upstream CLIProxyAPI image with the tailscale-identity plugin.
# Build from the repo root:
#   docker build -f deploy/Dockerfile.example -t cli-proxy-api-tailscale .
# The upstream image is Debian bookworm with a cgo build of CLIProxyAPI.
# The plugin builds in golang:1.26-bookworm, so both use the same glibc.

ARG CPA_IMAGE=eceasy/cli-proxy-api:latest

FROM golang:1.26-bookworm AS plugin
ENV GOTOOLCHAIN=auto CGO_ENABLED=1
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TAGS=""
ARG VERSION=0.2.1
RUN go build -trimpath -buildvcs=false -buildmode=c-shared -tags "${TAGS}" \
      -ldflags "-s -w -X github.com/1fc0nfig/cliproxy-tailscale/internal/tsid.Version=${VERSION}" \
      -o /out/tailscale-identity.so . && rm -f /out/*.h

FROM ${CPA_IMAGE}
ARG TARGETARCH
ARG VERSION=0.2.1
# plugins/<GOOS>/<GOARCH>/ is scanned before plugins/.
# If you mount a host directory over /CLIProxyAPI/plugins, copy the .so there instead.
COPY --from=plugin /out/tailscale-identity.so /CLIProxyAPI/plugins/linux/${TARGETARCH}/tailscale-identity-v${VERSION}.so
